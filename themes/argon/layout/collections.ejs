<% const items = kind === 'categories' ? site.categories : site.tags; %>
<p class="collection-intro"><%= kind === 'categories' ? '沿着一个主题，继续探索。' : '从一个关键字，找到下一篇手记。' %></p>
<div class="collection-grid <%= kind === 'tags' ? 'collection-tags' : '' %>">
	<% items.sort('name', 1).each(function(item) { %>
		<a class="collection-card" href="<%= url_for(item.path) %>">
			<span class="collection-name"><%= item.name %></span>
			<span class="collection-count"><%= item.length %> 篇 <span aria-hidden="true">↗</span></span>
		</a>
	<% }); %>
</div>
